{
  "name": "blunts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch app/server/evm-main.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx app/server/evm-main.ts",
    "test": "tsx --test --test-concurrency=1 app/tests/*.test.ts",
    "test:e2e": "playwright test --config playwright.evm.config.ts",
    "test:local-services": "playwright test --config playwright.steward.config.ts",
    "check": "npm run build && npm test",
    "db:backup": "tsx app/server/backup.ts",
    "format": "prettier --write app vite.config.ts playwright*.config.ts tsconfig.json package.json .github/workflows/checks.yml capacitor.config.ts scripts edge/worker.ts edge/tsconfig.json wrangler.jsonc",
    "format:check": "prettier --check app vite.config.ts playwright*.config.ts tsconfig.json package.json .github/workflows/checks.yml capacitor.config.ts scripts edge/worker.ts edge/tsconfig.json wrangler.jsonc",
    "ops": "tsx app/server/ops.ts",
    "providers:check": "tsx app/server/qualify-providers.ts",
    "providers:workbench": "tsx app/server/provider-workbench.ts",
    "mobile:sync": "node scripts/mobile.mjs",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "android:bundle": "cd android && ./gradlew bundleRelease",
    "ios:open": "cap open ios",
    "mobile:release-check": "node scripts/check-mobile.mjs",
    "start:legacy": "tsx app/server/main.ts",
    "test:e2e:legacy": "playwright test --config playwright.config.ts",
    "release:qualify-origin": "tsx scripts/qualify-release-origin.ts",
    "release:qualify-https": "node scripts/qualify-local-https.mjs",
    "worker:types": "wrangler types edge/worker-env.d.ts --env-interface CloudflareEnv --strict-vars=false",
    "worker:check": "npm run worker:types && tsc -p edge/tsconfig.json",
    "worker:deploy": "wrangler --profile nubs-images deploy",
    "worker:dev": "wrangler dev --local --ip 127.0.0.1 --port 8755 --infer-origin-from-routes=false"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.3",
    "@dinari/api-sdk": "0.15.0",
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "fastify": "^5.12.5",
    "lucide-react": "^1.62.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "viem": "^2.57.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wrangler": "^4.155.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
